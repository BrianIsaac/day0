ype="button" class="inline-flex min-h-11 shrink-0 items-center self-start whitespace-nowrap rounded-lg border border-[var(--color-danger)]/40 px-4 text-sm text-[var(--color-danger)] hover:bg-[var(--color-danger)]/10 disabled:opacity-50 sm:self-center">Reset everything</button></div></section></div><aside class="flex flex-col gap-6"><section class="rounded-xl border border-[var(--color-border)] bg-[var(--color-card)]"><div class="flex items-center justify-between border-b border-[var(--color-border)] py-1 pl-5 pr-2"><h2 class="text-sm font-semibold">Documentation</h2><a class="inline-flex min-h-11 items-center px-3 text-sm text-[var(--color-accent)]" href="/documentation">Manage</a></div><p class="px-5 py-4 text-sm text-[var(--color-muted)]">1 source linked. Every employee reads them unless you leave one out at deploy.</p></section></aside></div></div>"`;
