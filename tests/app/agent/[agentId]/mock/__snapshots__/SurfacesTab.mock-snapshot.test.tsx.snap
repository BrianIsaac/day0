exports[`keeps the hosted mock surfaces tab output 1`] = `"<div class="space-y-3"><div class="grid gap-3 md:grid-cols-2"><article id="surface-linear" class="rounded-lg border border-[var(--color-border)] p-4"><div class="flex items-center justify-between gap-2"><h3 class="font-medium">Linear</h3><span class="text-[10px] uppercase text-[var(--color-accent)]">proposed</span></div><p class="mt-1 text-xs text-[var(--color-muted)]">Waterfall 1 - kanban - mcp</p><div class="mt-4 flex flex-wrap gap-2"><button class="rounded border px-2 py-1 text-xs disabled:opacity-50">Approve as manager</button><button class="rounded border px-2 py-1 text-xs disabled:opacity-50">Approve as IT</button><button class="text-xs text-[var(--color-danger)]">Reject</button></div><p class="mt-2 text-[10px] text-[var(--color-muted)]">Probe runs automatically after both approvals.</p><p class="mt-3 text-[10px] text-[var(--color-muted)]">In this local single-user run, manager and IT are the same operator.</p></article></div></div>"`;
