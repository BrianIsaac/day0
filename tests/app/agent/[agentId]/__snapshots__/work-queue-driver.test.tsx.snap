// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`the work queue as the loop driver > keeps the mock queue markup fixed to the base render 1`] = `"<section class="bg-[var(--color-card)] border border-[var(--color-border)] rounded-xl p-4"><h2 class="text-sm font-semibold tracking-tight text-[var(--color-fg)] mb-3">Work queue · 3 items · 1 skill available</h2><div class="space-y-3"><div class="border border-[var(--color-border)] rounded-lg p-3"><div class="flex items-start justify-between mb-2"><div class="flex-1"><div class="flex items-center gap-2 mb-1"><span class="text-[10px] uppercase tracking-wider px-1.5 py-0.5 rounded bg-[var(--color-accent)]/15 text-[var(--color-accent)]">discovered</span><span class="text-[10px] text-[var(--color-muted)]">linear/ticket-queue</span></div><h3 class="text-sm font-medium text-[var(--color-fg)]">Item w-discovered</h3><p class="text-xs text-[var(--color-muted)] mt-1 line-clamp-2">Triage this Linear close summary.</p></div></div></div><div class="border border-[var(--color-border)] rounded-lg p-3"><div class="flex items-start justify-between mb-2"><div class="flex-1"><div class="flex items-center gap-2 mb-1"><span class="text-[10px] uppercase tracking-wider px-1.5 py-0.5 rounded bg-[var(--color-accent)]/15 text-[var(--color-accent)]">claimed</span><span class="text-[10px] text-[var(--color-muted)]">linear/ticket-queue</span></div><h3 class="text-sm font-medium text-[var(--color-fg)]">Item w-claimed</h3><p class="text-xs text-[var(--color-muted)] mt-1 line-clamp-2">Triage this Linear close summary.</p></div></div></div><div class="border border-[var(--color-border)] rounded-lg p-3"><div class="flex items-start justify-between mb-2"><div class="flex-1"><div class="flex items-center gap-2 mb-1"><span class="text-[10px] uppercase tracking-wider px-1.5 py-0.5 rounded bg-[var(--color-accent)]/15 text-[var(--color-accent)]">plan-approved</span><span class="text-[10px] text-[var(--color-muted)]">linear/ticket-queue</span></div><h3 class="text-sm font-medium text-[var(--color-fg)]">Item w-approved</h3><p class="text-xs text-[var(--color-muted)] mt-1 line-clamp-2">Triage this Linear close summary.</p></div></div><div class="mt-3 p-2 rounded-md bg-[var(--color-bg)] border border-[var(--color-border)] text-xs"><div class="font-medium text-[var(--color-fg)] mb-1">Plan (2m, reversible)</div><div class="text-[var(--color-muted)] mb-2">Tell the manager.</div><ol class="list-decimal pl-5 space-y-0.5 text-[var(--color-fg)]"><li>DM the manager.</li></ol></div></div></div></section>"`;
