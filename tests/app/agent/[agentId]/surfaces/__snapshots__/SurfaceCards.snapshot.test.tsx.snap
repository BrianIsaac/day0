exports[`keeps the hosted mock surfaces tab output 1`] = `"<div class="space-y-3"><div class="sr-only"><p role="status" aria-live="polite" aria-atomic="true" class="empty:sr-only text-xs leading-snug text-[var(--color-muted)]"></p></div><div class="grid gap-3 md:grid-cols-2"><article id="surface-linear" tabindex="-1" aria-labelledby="surface-linear-name" data-verdict="proposed" class="rounded-lg border border-[var(--color-border)] p-4"><div class="flex items-center justify-between gap-2"><h3 id="surface-linear-name" class="font-medium">Linear</h3><span class="text-[10px] uppercase text-[var(--color-accent)]">proposed</span></div><p class="mt-1 text-xs text-[var(--color-muted)]">Waterfall 1 - kanban - mcp</p><div class="mt-4 flex flex-wrap items-center gap-2"><button type="button" class="min-h-11 rounded border px-3 text-xs disabled:opacity-50">Approve</button><button type="button" class="min-h-11 px-3 text-xs text-[var(--color-danger)] disabled:opacity-50">Reject</button></div><p class="mt-2 text-[10px] text-[var(--color-muted)]">Probe runs automatically once you approve.</p></article></div></div>"`;
