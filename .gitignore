node_modules
.next
.env.local
.env.local.*
.env
*.tsbuildinfo
# Generated, and rewritten to a different path by `next dev` than by `next
# build`, so a tracked copy is dirty from a stranger's first `pnpm dev`.
next-env.d.ts
.DS_Store
.convex
dist
out
coverage

# clerk configuration (can include secrets)
/.clerk/

# internal planning docs, fixture content, and AI agent meta - not part of the public repo.
# `/docs/*` rather than `/docs/` because git will not look inside an excluded
# directory, so a negation under one can never take effect: excluding the
# entries lets `docs/running/` be re-included below.
/docs/*
!/docs/running/
!/docs/submission/
/docs/submission/*
!/docs/submission/compliance.md
/docs-fixture/
/docs-local/
AGENTS.md
CLAUDE.md

# local tooling state and logs
.claude/
.playwright-mcp/
*.log
.vercel

# playwright test artifacts
*.png
phase*.txt

# ...but the app's own icon assets are product surface, and the rule above would
# drop them from the repo without ever failing a build: the site would just
# serve a 404 where the icon should be.
!app/apple-icon.png
!app/opengraph-image.png
