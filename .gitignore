node_modules
.next
.env.local
.env.local.*
.env
*.tsbuildinfo
# Generated, and rewritten to a different path by `next dev` than by `next
# build`, so a tracked copy is dirty from a stranger's first `pnpm dev`.
next-env.d.ts
.DS_Store
.convex
dist
out
coverage

# clerk configuration (can include secrets)
/.clerk/

# internal planning docs, fixture content, and AI agent meta - not part of the public repo.
# `/docs/*` rather than `/docs/` because git will not look inside an excluded
# directory, so a negation under one can never take effect: excluding the
# entries lets `docs/running/` and `docs/standards/` (the engineering standard
# CONTRIBUTING points at, N27) be re-included below.
/docs/*
!/docs/running/
!/docs/standards/
/docs-fixture/
/docs-local/
AGENTS.md
CLAUDE.md

# local tooling state and logs
.claude/
.playwright-mcp/
*.log
.vercel

# playwright test artifacts (`playwright.config.ts` writes under `.next/`; a bare
# `playwright test` run elsewhere writes `test-results/`)
test-results/
*.png
phase*.txt

# ...but the app's own icon assets are product surface, and the rule above would
# drop them from the repo without ever failing a build: the site would just
# serve a 404 where the icon should be.
!app/apple-icon.png
!app/opengraph-image.png

# demo bed kit: snapshots and offline-rung results (`pnpm demo:bed`)
/.demo-bed/

# design tooling: agent skills and everything they write are dev-only, never public
/.agents/
/.impeccable/
/PRODUCT.md
/DESIGN.md
/DESIGN.md.*

# Q8: the vendored Convex agent skills and their lock stay on disk for whoever
# uses them and out of the public tree. The CLI's state file is what made an
# interactive `npx convex dev` reinstall them unprompted; `convex.json` turns
# that installer off (N17). The guidelines beside the state file are the
# same CLI's copy of a third-party prompt, and with the installer off they
# are a stale snapshot (U6 D3).
/skills/
/skills-lock.json
/convex/_generated/ai/ai-files.state.json
/convex/_generated/ai/guidelines.md

# the test issuer's throwaway TLS material (fake-oidc/make-tls.sh)
/fake-oidc/tls/
