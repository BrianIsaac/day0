{
  "name": "day0",
  "version": "0.0.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "tsx scripts/dev-no-auth-key.ts url && next dev -H localhost -p 3000",
    "dev:no-auth-key": "tsx scripts/dev-no-auth-key.ts init",
    "convex:dev": "convex dev",
    "convex:up": "tsx scripts/dev-docs-dir.ts && docker compose --env-file .env.local --profile dev up -d",
    "convex:down": "docker compose --env-file .env.local down",
    "convex:restart": "docker compose --env-file .env.local restart backend",
    "convex:admin-key": "docker compose --env-file .env.local exec backend ./generate_admin_key.sh",
    "model:up": "tsx scripts/model-up.ts",
    "model:down": "docker compose --env-file .env.local --profile model rm -sf model",
    "model:pull": "docker compose --env-file .env.local --profile model exec model ollama pull",
    "sandbox:up": "tsx scripts/dev-docs-dir.ts && docker compose --env-file .env.local --profile sandbox up -d sandbox backend",
    "sandbox:down": "docker compose --env-file .env.local --profile sandbox rm -sf sandbox",
    "sync:env": "./scripts/sync-convex-env.sh",
    "check:setup": "tsx scripts/check-setup.ts",
    "test": "vitest run",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "probe:model": "tsx --env-file-if-exists=.env.local scripts/probe-model-endpoint.ts",
    "probe:mcp": "tsx --env-file-if-exists=.env.local scripts/probe-mcp.ts",
    "probe:docs-source": "tsx --env-file-if-exists=.env.local scripts/probe-docs-source.ts",
    "probe:surface": "tsx --env-file-if-exists=.env.local scripts/probe-surface.ts"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100,
    "tabWidth": 2,
    "endOfLine": "lf"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.63",
    "@ai-sdk/react": "^3.0.0",
    "@clerk/nextjs": "^7.0.0",
    "@daytona/sdk": "^0.173.0",
    "@elevenlabs/elevenlabs-js": "^2.46.0",
    "@elevenlabs/react": "^1.5.0",
    "@google/genai": "^2.0.0",
    "@mastra/core": "^1.32.1",
    "@mastra/mcp": "^1.17",
    "@t3-oss/env-nextjs": "^0.13.11",
    "ai": "^6.0.176",
    "convex": "^1.37.0",
    "exa-js": "^2.12.1",
    "next": "^16.2.6",
    "openai": "^6.37.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "turndown": "^7.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/turndown": "^5.0.6",
    "convex-test": "^0.0.54",
    "eslint": "^9.16.0",
    "eslint-config-next": "^16.2.6",
    "postcss": "^8.5.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
