# Day0 environment contract. Copy to .env.local and fill in.
# Next, ./scripts/sync-convex-env.sh and every `pnpm convex:*` command read
# this file; plain `docker compose` does not. Keep a trailing newline: the
# Convex CLI and `pnpm dev:no-auth-key` append lines to it.

# --- Convex backend ---
# Cloud or anonymous deployment. Written by `pnpm convex:dev`; leave empty
# when self-hosting (setting both is refused by `pnpm check:setup`).
CONVEX_DEPLOYMENT=
# Written by `pnpm convex:dev`. Self-hosted: http://127.0.0.1:<CONVEX_PORT>.
NEXT_PUBLIC_CONVEX_URL=
# Written by `pnpm convex:dev`; nothing in day0 reads it. Self-hosted:
# http://127.0.0.1:<CONVEX_SITE_PROXY_PORT>.
NEXT_PUBLIC_CONVEX_SITE_URL=
# Self-hosted backend (`pnpm convex:up`). The admin key comes from
# `pnpm convex:admin-key` and belongs to the data volume: regenerate it for a
# fresh volume.
CONVEX_SELF_HOSTED_URL=
CONVEX_SELF_HOSTED_ADMIN_KEY=
# Compose project the stack runs as. Set it when the clone directory is not
# `day0`; `pnpm check:setup` looks for this name.
COMPOSE_PROJECT_NAME=
# Host address and ports docker compose publishes. Move all three ports (and
# NEXT_PUBLIC_CONVEX_URL, NEXT_PUBLIC_CONVEX_SITE_URL, CONVEX_SELF_HOSTED_URL
# with them) to run a second stack; containers keep 3210/3211/6791.
CONVEX_BIND_ADDR=127.0.0.1
CONVEX_PORT=3210
CONVEX_SITE_PROXY_PORT=3211
CONVEX_DASHBOARD_PORT=6791
# The backend's own view of itself. Override only with an address that
# resolves inside the container; empty keeps the container ports.
CONVEX_CLOUD_ORIGIN=
CONVEX_SITE_ORIGIN=
# What the browser calls the backend when that differs (a LAN address for
# phone testing). Read by the dashboard container only.
CONVEX_BROWSER_ORIGIN=

# --- Bundled model service (`pnpm model:up`) ---
# Host port. Move it, and OPENAI_BASE_URL with it, if a native `ollama serve`
# already holds 11434. CONVEX_OPENAI_BASE_URL stays on the container port.
MODEL_PORT=11434
# Input window the service starts with; 16384 fits the qwen3:8b path.
OLLAMA_CONTEXT_LENGTH=16384
# `auto` uses an NVIDIA GPU when the driver is present, `on` requires one,
# `off` never asks. MODEL_GPU_COUNT reserves that many devices.
MODEL_GPU=auto
MODEL_GPU_COUNT=all

# --- No-auth dev mode (skip for the Clerk path) ---
# `true` skips Clerk and serves one fixed local user. Refused outside
# `next dev` and on any hosted platform; clear it before `pnpm build`.
NEXT_PUBLIC_DEV_NO_AUTH=
# Generated by `pnpm dev:no-auth-key`; never type them by hand. The JWKS is
# the only one of the three that ./scripts/sync-convex-env.sh pushes.
DEV_NO_AUTH_SECRET=
DEV_NO_AUTH_SIGNING_KEY=
DEV_NO_AUTH_JWKS=

# --- Clerk (per-user auth; skip for no-auth mode) ---
# https://dashboard.clerk.com/last-active?path=api-keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Issuer URL of the JWT template named `convex`, no trailing slash.
# ./scripts/sync-convex-env.sh pushes it to the deployment.
CLERK_JWT_ISSUER_DOMAIN=
# Read by the Clerk SDK.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# --- The model (charter, plans, executor, skill author) ---
# Three complete setups; `pnpm probe:model` checks an endpoint first.
#   key, no base URL        OpenAI          https://platform.openai.com/api-keys
#   base URL, no key        local runtime   ollama, llama.cpp, LM Studio, vLLM
#   key and base URL        hosted gateway  e.g. Featherless, with its own key
OPENAI_API_KEY=
# Where Next calls the model. Empty means https://api.openai.com/v1.
#   http://127.0.0.1:11434/v1       local runtime
#   https://api.featherless.ai/v1   Featherless (OPENAI_API_KEY = its key)
OPENAI_BASE_URL=
# Where the Convex deployment calls the same model when that address differs;
# a self-hosted backend cannot reach 127.0.0.1 on this machine. Pushed by
# ./scripts/sync-convex-env.sh as the deployment's OPENAI_BASE_URL; both empty
# clears it there.
#   http://model:11434/v1                  bundled service
#   http://host.docker.internal:11434/v1   a server on this host
CONVEX_OPENAI_BASE_URL=
# A model the endpoint serves: `gpt-5.6-terra` on OpenAI, `qwen3:8b` locally,
# a gateway's own id (`GET <base-url>/models`).
OPENAI_MODEL=gpt-5.6-terra
# `auto` tries response_format then falls back to prompt injection;
# `native` or `prompt` pins one.
OPENAI_JSON_MODE=auto
# Schema-invalid prompt replies get up to two replacements. 0 disables; maximum 3.
OPENAI_STRUCTURED_REPAIR_ATTEMPTS=2
# Unset preserves the provider's output budget and reasoning defaults.
# Featherless GLM 5.3 Flash: budget 32768, effort low, JSON mode prompt.
OPENAI_MAX_OUTPUT_TOKENS=
OPENAI_REASONING_EFFORT=
# Read by scripts/probe-china-connectivity.sh only; the app reads
# OPENAI_API_KEY. https://featherless.ai/account/api-keys
FEATHERLESS_API_KEY=

# --- ElevenLabs (voice for the Day-1 1:1; optional) ---
# https://elevenlabs.io/app/settings/api-keys, then the Conversational AI
# agent's id from its settings page.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Signs the post-call webhook; without it every delivery is refused with 503.
# Developers -> Webhooks -> Create webhook (the secret is shown once), then
# set it as the agent's post-call webhook.
ELEVENLABS_WEBHOOK_SECRET=

# --- Exa (good-habits research; optional) ---
# https://dashboard.exa.ai/api-keys
EXA_API_KEY=

# --- Skill verification sandbox ---
# Daytona wins when both are available; the bundled local sandbox
# (`pnpm sandbox:up`) needs nothing. https://app.daytona.io/dashboard/keys
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
# Socket path the deployment uses for the local sandbox. Empty is right for
# the bundled stack; set it only for a backend running outside compose.
SKILL_SANDBOX_SOCKET=
# Seconds a smoke test may run. Read by docker-compose.yml.
SKILL_SANDBOX_TIMEOUT_SECONDS=60

# --- Real mode (local no-auth development only) ---
# `real` lets the agent act on your own systems; refused unless
# NEXT_PUBLIC_DEV_NO_AUTH=true and NODE_ENV=development.
DAY0_SURFACE_MODE=mock
# Documentation folder. The host path is Compose's (created empty when it is
# the default); DAY0_DOCS_ROOT is where Convex actions see it.
DAY0_DOCS_HOST_DIR=./docs-local
DAY0_DOCS_ROOT=/docs
# Generated by `pnpm dev:no-auth-key` before the first `pnpm convex:up`.
# The key encrypts every stored credential; the token guards the hop to the
# Notion component (`--profile docs-notion`).
DAY0_CREDENTIAL_KEY=
DAY0_NOTION_MCP_AUTH_TOKEN=
# Browser component. Empty means none, and every browser action is refused
# with BROWSER_DRIVER_ABSENT. Bundled: `pnpm convex:up --profile browser` and
#   DAY0_BROWSER_MCP_URL=http://playwright-mcp:8931/mcp
DAY0_BROWSER_MCP_URL=
# The redaction component: the span model documentation sync and the ledger
# redact with, paired with --profile redactor (`pnpm redactor:up`). The address
# is the one the backend container reaches it at. Unset means no component:
# a documentation sync refuses to persist, and a provider outcome records that
# only the exact-value and structural layers protected it.
#   DAY0_REDACTOR_URL=http://redactor:8000
DAY0_REDACTOR_URL=
# Semicolon-separated origins the browser component may open.
PLAYWRIGHT_ALLOWED_ORIGINS=http://looker-tile:8080;http://host.docker.internal:3000
# Public https origin an OAuth install redirects back to, no trailing slash.
# Needed only to provision a dedicated Slack app; a cloudflared tunnel works.
DAY0_PUBLIC_URL=
# The real-mode rehearsal (`pnpm rehearse:real`) reads this file read-only for
# the application values above and takes LINEAR_API_KEY and SLACK_BOT_TOKEN
# from its own --secrets file (mode 0600). Neither key belongs here: the
# sync script would push it to the deployment, and the cards are where a
# credential is landed.

# --- Demo defaults ---
# The manager's email. Real mode resolves the Slack DM from it and stores it
# on the agent at deploy, so set it before deploying.
NEXT_PUBLIC_DEMO_BOSS_EMAIL=
# Key prefix for the demo tenant in Convex.
NEXT_PUBLIC_DEMO_TENANT_SLUG=acme-demo

# --- Test and demo fixtures (compose profiles `test` and `demo`) ---
# Redirect Slack calls to the bundled fake service. Refused outside local
# no-auth real mode; leave empty for a real workspace.
DAY0_TEST_SLACK_API_URL=
DAY0_TEST_SLACK_AUTHORIZE_URL=
FAKE_SLACK_HOST_PORT=8090
# Login of the synthetic web-UI-only tile; its own documentation publishes it.
LOOKER_TILE_USER=revops
LOOKER_TILE_PASSWORD=pipeline-tile-local
