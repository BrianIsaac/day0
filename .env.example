# Day0 - environment contract
# Copy to .env.local and fill in real values. Everything here is read from
# .env.local: Next loads it, ./scripts/sync-convex-env.sh pushes the keys the
# Convex deployment needs, and `pnpm convex:up` hands it to docker compose with
# `--env-file .env.local`. Plain `docker compose up` does not read this file.

# --- Convex (DB + actions + scheduler) ---
# Run `pnpm convex:dev` once to create the deployment; values get written automatically.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# --- Self-hosted Convex backend (optional; skip for Convex cloud) ---
# `pnpm convex:up` starts it, `pnpm convex:admin-key` prints the admin key.
CONVEX_SELF_HOSTED_URL=
CONVEX_SELF_HOSTED_ADMIN_KEY=
# The host address docker compose publishes the backend, HTTP action and
# dashboard ports on. Loopback keeps a backend that has no authentication of its
# own off your network. It is hygiene rather than a boundary, and nothing but
# docker-compose.yml reads it.
CONVEX_BIND_ADDR=127.0.0.1
# Host ports. Move all three to run a second backend beside the first; pair them
# with `docker compose -p <name>` so the two stacks own separate volumes. They
# publish the container's fixed 3210/3211/6791 - the backend's own view of itself
# stays canonical whatever you set here, which is what keeps Node actions able to
# reach it. NEXT_PUBLIC_CONVEX_URL and CONVEX_SELF_HOSTED_URL follow CONVEX_PORT.
CONVEX_PORT=3210
CONVEX_SITE_PROXY_PORT=3211
CONVEX_DASHBOARD_PORT=6791
# Host port for the optional bundled model service (`pnpm model:up`). Only Next
# uses it; the backend reaches that container by name over the compose network.
# It is also the port a native `ollama serve` takes, so move it (and
# OPENAI_BASE_URL with it) if `pnpm model:up` reports `port is already
# allocated` - or skip the bundled service and point at the server you have.
MODEL_PORT=11434
# Day0's charter and executor prompts include the manager-approved charter,
# discovered documentation, runbook guidance and action schema. Ollama's small
# server default can truncate that context before the model sees it; 16384 fits
# the shipped qwen3:8b path while staying below that model's own limit.
OLLAMA_CONTEXT_LENGTH=16384
# Whether that service gets a GPU. `auto` looks for an NVIDIA driver, layers
# docker-compose.gpu.yml on when it finds one, and falls back to the CPU if
# Docker then declines to hand a device over - the container toolkit is the
# usual missing piece. `on` requires one and fails loudly instead; `off` never
# asks. MODEL_GPU_COUNT reserves that many devices rather than all of them.
MODEL_GPU=auto
MODEL_GPU_COUNT=all
# What the *browser* should call the backend, when that differs from the address
# above - a LAN address for phone testing, say. Only the Convex dashboard
# container reads it; the app reads NEXT_PUBLIC_CONVEX_URL.
CONVEX_BROWSER_ORIGIN=

# --- No-auth dev mode (optional; skip for the Clerk path) ---
# `true` skips Clerk end to end and serves every request as one fixed local user
# who owns every row. It is refused outside `next dev`, and refused for any
# caller who cannot present the local key below.
NEXT_PUBLIC_DEV_NO_AUTH=
# Generated together by `pnpm dev:no-auth-key`; leave them blank here.
#   DEV_NO_AUTH_SECRET       unlocks a browser. `pnpm dev` prints the URL that
#                            carries it. Never leaves this machine otherwise.
#   DEV_NO_AUTH_SIGNING_KEY  signs the token Convex accepts. Never leaves this
#                            machine at all.
#   DEV_NO_AUTH_JWKS         the public half of that key. Pushed to the
#                            deployment by ./scripts/sync-convex-env.sh so it can
#                            verify a token without being able to mint one.
DEV_NO_AUTH_SECRET=
DEV_NO_AUTH_SIGNING_KEY=
DEV_NO_AUTH_JWKS=

# --- Clerk (per-user auth so each visitor has their own demo) ---
# https://dashboard.clerk.com/last-active?path=api-keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# In Clerk dashboard: JWT Templates -> New template -> name: "convex".
# Copy the "Issuer" URL (no trailing slash) into the value below + into Convex env:
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN <url>
CLERK_JWT_ISSUER_DOMAIN=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# --- The model (charter synthesis, plan-draft, executor, skill author) ---
# Any OpenAI-compatible chat-completions endpoint will do; OpenAI itself is the
# default rather than a requirement. Two complete setups, and the choice between
# them is about who runs the model rather than about what works:
#   a key and no base URL   OpenAI answers, and you pay per token
#     https://platform.openai.com/api-keys
#   a base URL and no key   a local runtime answers, and no account exists
# `pnpm probe:model` tells you whether a given endpoint can drive the loop
# before you wire it into a demo.
OPENAI_API_KEY=
# Where *Next* calls the model. Unset means https://api.openai.com/v1.
#   http://127.0.0.1:11434/v1     ollama, llama.cpp, LM Studio, vLLM, ...
OPENAI_BASE_URL=
# Where the *Convex deployment* calls the same model, when that is a different
# address. It usually is with a self-hosted backend and a model on this machine:
# charter synthesis is a Node action running inside the backend container, and
# the loopback address above means that container, not your machine. A hosted
# endpoint needs neither variable - api.openai.com is one address from both
# sides. ./scripts/sync-convex-env.sh pushes this as the deployment's
# OPENAI_BASE_URL; empty pushes the local one, and both empty clears it there so
# the deployment falls back to OpenAI rather than keeping a stale local address.
#   http://model:11434/v1                  the bundled model service, `pnpm model:up`
#   http://host.docker.internal:11434/v1   a server on this host
CONVEX_OPENAI_BASE_URL=
# A model the endpoint above actually serves. `gpt-5.6-terra` is OpenAI's name for it;
# a local runtime wants its own, e.g. `qwen3:8b`.
OPENAI_MODEL=gpt-5.6-terra
OPENAI_IMAGE_MODEL=gpt-image-2
# How structured output is asked for: `auto` starts with response_format and
# falls back to prompt injection only when dropping the parameter is what fixed
# it. Pin `prompt` for a server that never honours it.
OPENAI_JSON_MODE=auto

# --- ElevenLabs (primary voice path for Day-1 1:1) ---
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Create a Conversational AI agent in the dashboard and paste its id here
ELEVENLABS_AGENT_ID=
# Signs the post-call webhook, and the two keys above do not cover it: without
# it voice still connects and still produces a charter, and only the post-call
# delivery is refused - every one of them, with a 503. It is what the tab-death
# fallback runs on.
#   ElevenLabs dashboard -> Developers -> Webhooks -> Create webhook. The
#   shared secret is shown once, when the webhook is created. Then point your
#   agent at it: https://elevenlabs.io/app/agents/settings -> post-call webhook.
# `pnpm check:setup` reports voice and post-call finalisation separately.
ELEVENLABS_WEBHOOK_SECRET=

# --- Google Gemini (fallback voice path; gen-media if needed) ---
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_LIVE_MODEL=gemini-flash-3.1-live

# --- Exa (web research for good-habits memory) ---
# https://dashboard.exa.ai/api-keys
EXA_API_KEY=

# --- Skill verification sandbox ---
# An authored skill becomes callable only once a sandbox has run its smoke
# test, and there are two ways to have one. Daytona is a hosted service and
# needs an account; the bundled local sandbox is a container with no network,
# started by `pnpm sandbox:up`, and needs nothing. Daytona wins when both are
# available. With neither, an authored skill stops at `authoring` and stays
# visibly uncallable - `pnpm check:setup` reports which of the two you have.
#   https://app.daytona.io/dashboard/keys
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
# Where the *Convex deployment* finds the local sandbox's socket. Empty is
# right for the bundled stack: docker-compose.yml mounts the shared volume at
# the path the code already defaults to, so there is nothing to set and nothing
# to keep in step. Set it only for a backend running somewhere else - an
# anonymous deployment as an ordinary process on this machine, say - and point
# it at a path that process can see.
SKILL_SANDBOX_SOCKET=
# How long a smoke test may run before the sandbox kills it. Read by
# docker-compose.yml, not by the app; the default matches the Daytona path.
SKILL_SANDBOX_TIMEOUT_SECONDS=60

# --- Real local surfaces (optional; never used by the hosted mock) ---
# Documentation folders are mounted read-only into the self-hosted backend.
# The host path is Compose-only; Convex actions see DAY0_DOCS_ROOT. The
# default is created empty by `pnpm convex:up` when it is missing; any other
# path must already exist, and Compose never creates it.
DAY0_DOCS_HOST_DIR=./docs-local
DAY0_DOCS_ROOT=/docs
DAY0_SURFACE_MODE=mock
# Generated by `pnpm dev` and pushed to the local Convex deployment. Do not
# share or commit the generated value; it encrypts every stored credential.
DAY0_CREDENTIAL_KEY=
# Generated alongside the credential key. It authenticates only the private
# compose-network hop to day0's Notion documentation component
# (`pnpm convex:up --profile docs-notion`), whose locator for a new link is
# http://docs-notion-mcp:3000/mcp. Needed only for a Notion documentation
# source; folder, git and URL sources need no component at all.
DAY0_NOTION_MCP_AUTH_TOKEN=
# The public https origin a provider redirects a completed OAuth install back
# to, with no trailing slash. Needed only to provision a dedicated app for an
# employee (the manifest declares `<this>/api/oauth/slack` as its redirect).
# For the demo, a named cloudflared tunnel on your own Cloudflare account gives
# a hostname that survives a restart:
#   cloudflared tunnel create day0 && cloudflared tunnel route dns day0 <host>
#   cloudflared tunnel run --url http://localhost:3000 day0
# For a one-off test, `cloudflared tunnel --url http://localhost:3000` prints a
# fresh hostname each time - fine to try the flow, but a restart invalidates
# every manifest already registered against the old one.
DAY0_PUBLIC_URL=
# Isolated proof only: redirect Slack API calls to the bundled fake service and
# make its synthetic install link clickable from this host. Both are refused
# outside local no-auth real mode. Leave empty for every real Slack workspace.
DAY0_TEST_SLACK_API_URL=
DAY0_TEST_SLACK_AUTHORIZE_URL=
FAKE_SLACK_HOST_PORT=8090
# day0's browser component, and the switch that turns it on.
#
# Blank means this deployment has no browser component: a system whose
# documentation records a web UI and no API is still proposed and still shows
# its evidence, its card says the component is not running, and every browser
# action, probe and intake sweep refuses with BROWSER_DRIVER_ABSENT. That is a
# complete installation if none of your systems need a browser.
#
# To run it, start the component and name it here - the two go together:
#   pnpm convex:up --profile browser
#   DAY0_BROWSER_MCP_URL=http://playwright-mcp:8931/mcp
#   pnpm sync:env
#
# The surface's own endpoint stays the documented web UI address and is never
# taken from here - the driver is how a system is reached, not what is reached.
DAY0_BROWSER_MCP_URL=
# Semicolon-separated origins the browser floor may request.
PLAYWRIGHT_ALLOWED_ORIGINS=http://looker-tile:8080;http://host.docker.internal:3000
# The synthetic web-UI-only system the browser floor is demonstrated against.
# These are the credentials its own documentation page publishes, which is the
# point: the agent discovers the login from the docs like any other credential.
LOOKER_TILE_USER=revops
LOOKER_TILE_PASSWORD=pipeline-tile-local

# --- Demo defaults ---
# The boss email pre-filled on the deploy form (you, the demo operator).
NEXT_PUBLIC_DEMO_BOSS_EMAIL=
# A short tenant slug for the demo company (used as a key prefix in Convex).
NEXT_PUBLIC_DEMO_TENANT_SLUG=acme-demo
