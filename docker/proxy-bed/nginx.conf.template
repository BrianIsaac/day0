# The nginx configuration docs/running/proxy.md prints, as the bed day0-w17p ran it (wave 17,
# 17-P): two https origins, one for the app and one for the backend, each forwarded to a port on
# this machine's loopback. On a customer's machine each `listen` and `server_name` is the
# customer's own, and the certificate is theirs. The bed's addresses and ports are substituted
# from its environment by the image's own template step.

# The live connection: a request that asks to upgrade is passed on as one, any other is not.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# The app: `pnpm start`, on 127.0.0.1.
server {
    listen ${PROXY_BED_ADDRESS}:${PROXY_BED_APP_PORT} ssl;
    ssl_certificate     /tls/cert.pem;
    ssl_certificate_key /tls/key.pem;

    # A page's form posts up to 4 MB (next.config.mjs, serverActions); nginx allows 1 MB unasked.
    client_max_body_size 5m;

    location / {
        proxy_pass http://127.0.0.1:${DAY0_APP_PORT};
        proxy_http_version 1.1;
        # The host people typed, which Day0 checks a request's origin against.
        proxy_set_header Host              $http_host;
        proxy_set_header X-Forwarded-Host  $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        # A streamed reply may take the model a minute; nginx gives an upstream 60 s unasked.
        proxy_read_timeout 120s;
        # Buffering stays on: the two streamed routes send `X-Accel-Buffering: no` themselves.
    }
}

# The backend: the browser's live connection is a WebSocket here.
server {
    listen ${PROXY_BED_ADDRESS}:${PROXY_BED_BACKEND_PORT} ssl;
    ssl_certificate     /tls/cert.pem;
    ssl_certificate_key /tls/key.pem;

    client_max_body_size 20m;

    location / {
        proxy_pass http://127.0.0.1:${CONVEX_PORT};
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host       $http_host;
        # The connection stays open for as long as a page does.
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }
}
